      "source": [
        "import pandas as pd\n",
        "\n",
        "# Create data for 20 construction workers\n",
        "data = {\n",
        "    'Employee Name': ['Joseph Vabbe', 'Carla Menendez', 'Valery Swahss', 'Vania Anderson', 'Camila Mendes',\n",
        "                      'Julie Colm', 'Jordan Anderson', 'Louis Bent', 'Maia Millert', 'Ben Carroll',\n",
        "                      'Ana Galvez', 'Alex Patterson', 'Maya West', 'Camila Blanco', 'David Jeff',\n",
        "                      'Carlos Fort', 'Steph Flores', 'Lis Harush', 'Mia Benort', 'John Smith'],\n",
        "    'Department': ['Electrician', 'Carpenter', 'Supervisor', 'Assistant', 'Laborer',\n",
        "                   'Sales', 'Sales', 'Sales', 'Marketing', 'Technician',\n",
        "                   'Account', 'Customer Support', 'Sales', 'Customer Support', 'Junior Developer',\n",
        "                   'Senior Developer', 'Sales Director', 'Executive Assistant', 'Maintenance', 'Electrician'],\n",
        "    'Hourly Rate': [25, 22, 31, 18, 16, 14, 14, 14, 35, 25, 45, 14, 14, 14, 65, 135, 30, 25, 16, 25],\n",
        "    'Hours Worked': [45, 35, 40, 47, 50, 40, 40, 40, 45, 40, 30, 50, 40, 40, 40, 40, 50, 40, 40, 45]\n",
        "}\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Calculate base pay (Hourly rate * hours worked)\n",
        "df['Base Pay'] = df['Hourly Rate'] * df['Hours Worked']\n",
        "\n",
        "# Calculate Bonus (If hours > 40, then base pay * 0.15, else 0)\n",
        "df['Bonus'] = df.apply(lambda row: row['Base Pay'] * 0.15 if row['Hours Worked'] > 40 else 0, axis=1)\n",
        "\n",
        "# Calculate Total Pay\n",
        "df['Total Pay'] = df['Base Pay'] + df['Bonus']\n",
        "\n",
        "# Display the table\n",
        "print(df)\n",
        "\n"
      ],
